SELECT
    customers.first_name,
    earlier_payment.payment_id AS earlier_payment_id,
    earlier_payment.amount AS earlier_amount,
    later_payment.payment_id AS later_payment_id,
    later_payment.amount AS later_amount,
    CASE
        WHEN later_payment.amount > earlier_payment.amount THEN 'Growth'
        ELSE 'No Growth'
    END AS payment_trend
FROM payments AS earlier_payment
INNER JOIN payments AS later_payment
ON earlier_payment.customer_id = later_payment.customer_id
AND earlier_payment.payment_id < later_payment.payment_id
INNER JOIN customers
ON earlier_payment.customer_id = customers.customer_id
WHERE later_payment.amount > earlier_payment.amount;
